<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.YizhiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.YizhiEntity" id="yizhiMap">
        <result property="weizhi" column="weizhi"/>
        <result property="mianji" column="mianji"/>
        <result property="faxianshijian" column="faxianshijian"/>
        <result property="leixing" column="leixing"/>
        <result property="kengneiwupin" column="kengneiwupin"/>
        <result property="lishijiazhi" column="lishijiazhi"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.YizhiView" >

		SELECT  yizhi.* FROM yizhi  yizhi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.YizhiView" >
		SELECT * FROM yizhi  yizhi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
