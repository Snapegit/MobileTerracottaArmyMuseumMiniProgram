<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.DaolanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.DaolanEntity" id="daolanMap">
        <result property="bowuguanmingcheng" column="bowuguanmingcheng"/>
        <result property="daolandizhi" column="daolandizhi"/>
        <result property="tupian" column="tupian"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.DaolanView" >

		SELECT  daolan.* FROM daolan  daolan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.DaolanView" >
		SELECT * FROM daolan  daolan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
