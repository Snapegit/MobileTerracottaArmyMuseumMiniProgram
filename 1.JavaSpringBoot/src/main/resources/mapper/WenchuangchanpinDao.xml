	<select id="selectView"
		resultType="com.cl.entity.view.WenchuangchanpinView" >
		SELECT * FROM wenchuangchanpin  wenchuangchanpin <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
