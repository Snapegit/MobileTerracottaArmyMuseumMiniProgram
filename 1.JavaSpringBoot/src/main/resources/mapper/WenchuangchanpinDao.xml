    <select id="selectListView"
		resultType="com.cl.entity.view.WenchuangchanpinView" >

		SELECT  wenchuangchanpin.* FROM wenchuangchanpin  wenchuangchanpin 	        
        <where> 1=1 ${ew.sqlSegment}</where>
