<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ZhanlanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ZhanlanEntity" id="zhanlanMap">
        <result property="zhanpinmingcheng" column="zhanpinmingcheng"/>
        <result property="zhanpinmiaoshu" column="zhanpinmiaoshu"/>
        <result property="zhanpintupian" column="zhanpintupian"/>
        <result property="xiangguangushi" column="xiangguangushi"/>
        <result property="canguanxianlujianyi" column="canguanxianlujianyi"/>
        <result property="zhuyishixiang" column="zhuyishixiang"/>
        <result property="clicktime" column="clicktime"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ZhanlanView" >

		SELECT  zhanlan.* FROM zhanlan  zhanlan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ZhanlanView" >
		SELECT * FROM zhanlan  zhanlan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
